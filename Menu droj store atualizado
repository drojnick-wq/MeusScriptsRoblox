-- Toggle
local function CreateToggle(name, labelText, callback)
    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, 0, 0, 30)
    f.BackgroundTransparency = 1
    f.Parent = ScrollingFrame

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0, 160, 1, 0); lbl.Position = UDim2.new(0, 0, 0, 0)
    lbl.BackgroundTransparency = 1; lbl.Text = labelText
    lbl.TextColor3 = Color3.new(1,1,1); lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Font = Enum.Font.Gotham; lbl.TextSize = 14; lbl.Parent = f

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 60, 0, 20); btn.Position = UDim2.new(1, -60, 0.5, -10)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    btn.Text = "OFF"; btn.TextColor3 = Color3.new(1,0,0)
    btn.Font = Enum.Font.GothamBold; btn.TextSize = 12; btn.Parent = f

    local state = false
    local function upd()
        if state then
            btn.Text = "ON"; btn.TextColor3 = Color3.new(0,1,0)
            btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        else
            btn.Text = "OFF"; btn.TextColor3 = Color3.new(1,0,0)
            btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        end
        if callback then callback(state)
        elseif name == "Aimbot" then aimbotEnabled = state
        else espEnabled[name] = state end
    end
    upd()
    btn.MouseButton1Click:Connect(function() state = not state; upd() end)
end

